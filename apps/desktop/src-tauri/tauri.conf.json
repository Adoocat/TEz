{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TEz",
  "mainBinaryName": "TEz",
  "version": "0.1.0",
  "identifier": "com.demirkan.tez",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @tez/web dev",
    "beforeBuildCommand": "pnpm --filter @tez/web build"
  },
  "app": {
    "windows": [
      {
        "title": "TEz",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tez"
        ]
      }
    }
  }
}
