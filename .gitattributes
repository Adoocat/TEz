# Normalize line endings: LF in the repo and working tree, except Windows scripts.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Real database exports (Task 26): keep their bytes, line endings included.
backend/tests/fixtures/imports/presets/** -text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.sqlite binary
*.gz binary
*.zip binary
*.exe binary
*.dll binary

# Generated / lock files: no textual diffs in reviews
pnpm-lock.yaml linguist-generated=true -diff
uv.lock linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff
apps/web/src/api/** linguist-generated=true
