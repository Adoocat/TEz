{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TEz",
  "mainBinaryName": "TEz",
  "version": "0.0.1",
  "identifier": "com.demirkan.tez.s1",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TEz (S1 spike)",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tez"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/tez-backend"],
    "resources": {
      "../../backend/dist/tez-backend/_internal/": "_internal/",
      "../../cli/target/release/tez.exe": "bin/tez.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
